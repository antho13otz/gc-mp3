# Numeros de build (GitLab, depuis la suspension du compte GitHub).
# Sur GitHub, chaque compilation prenait un numero tout seul ; ici, le numero est ecrit dans ce fichier
# et change dans le MEME commit que le changement qu'il publie (un numero de plus seulement pour ce qui est recompile).
# Derniers publies sur GitHub : console 906 (v377), appli 450, PC 46 (PC 2).
CONSOLE_BUILD=950
APPLI_BUILD=559
PC_BUILD=46
